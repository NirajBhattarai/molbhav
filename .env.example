# Magic (https://dashboard.magic.link): publishable key (pk_live_… / pk_test_…).
# Allow the app origins (http://localhost:3000 and the deployed URL).
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=

# Hedera network for the Magic wallet: testnet (default) or mainnet.
NEXT_PUBLIC_HEDERA_NETWORK=testnet

# Magic secret key (sk_live_… / sk_test_…). Server only: never NEXT_PUBLIC_.
MAGIC_SECRET_KEY=

# Signs the session cookie. Any long random string: `openssl rand -base64 32`.
SESSION_SECRET=

# Public app URL (no trailing slash). Stall sign claims, Agent Card links, and the in-app
# buyer A2A client use this as the origin (e.g. http://localhost:3000 or https://….vercel.app).
# NEXT_PUBLIC_APP_URL=

# Optional. Ed25519 offer keys for stall Agent Cards (A2A). Falls back to a hash of SESSION_SECRET.
# A2A_SIGNING_SECRET=

# Postgres (Neon pooled connection string).
DATABASE_URL=

# Google Gemini (https://aistudio.google.com/apikey): scan menu photos into items.
# Without this, shopkeepers add items by hand only. Server only: never NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional model id (default gemini-flash-latest).
# GEMINI_MODEL=

# Redis (Vercel → Storage → Redis). `vercel env pull .env.local` fills it in,
# or copy the connection string: redis://default:<password>@<host>:<port>.
REDIS_URL=
# Seconds to cache buyer discovery preference in Redis before re-reading Postgres (default 300).
# DISCOVERY_CACHE_TTL=300
# Seconds a stall chat stays in Redis (default 3600).
# CHAT_CACHE_TTL=3600

# Optional. ENS names for stall agents (ENSv2 on Sepolia), e.g. mohd-soyeb-khan.molbhav.eth.
# `npm run ens:wallet` makes ENS_REGISTRAR_KEY (fund it with Sepolia ETH), then `npm run ens:setup`
# registers the parent name and prints ENS_REGISTRY. Without them, stalls simply have no ENS name.
# ENS_REGISTRAR_KEY=
# ENS_PARENT=molbhav.eth
# ENS_REGISTRY=
# ENS_PARENT_RESOLVER=
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# x402 payments on Hedera (docs/x402.md): buyers pay agreed deals in testnet HBAR from their Magic
# Hedera wallet; the facilitator pays the fee and settles. Defaults shown.
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_INR_PER_HBAR=15

# Deal log on Hedera Consensus Service (docs/hcs.md): every agreed and paid deal is posted to a
# topic only this operator can write to. Use a portal.hedera.com testnet account, then run
# `npm run hcs:topic` once to create the topic and save HEDERA_DEAL_TOPIC. Without them, no log.
# HEDERA_OPERATOR_ID=0.0.xxxxxxx
# HEDERA_OPERATOR_KEY=302e0201...
# HEDERA_DEAL_TOPIC=0.0.xxxxxxx
