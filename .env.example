# Magic (https://dashboard.magic.link): publishable key (pk_live_… / pk_test_…).
# Allow the app origins (http://localhost:3000 and the deployed URL).
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=

# Magic secret key (sk_live_… / sk_test_…). Server only: never NEXT_PUBLIC_.
MAGIC_SECRET_KEY=

# Signs the session cookie. Any long random string: `openssl rand -base64 32`.
SESSION_SECRET=

# Postgres (Neon pooled connection string).
DATABASE_URL=

# Google Gemini (https://aistudio.google.com/apikey): scan menu photos into items.
# Without this, shopkeepers add items by hand only. Server only: never NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional model id (default gemini-flash-latest).
# GEMINI_MODEL=
